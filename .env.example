# Copy this to .env and fill in whichever route you use.
# .env is gitignored. Neither route is needed for the free reader.

# --- Route 1: straight to OpenAI -------------------------------------------
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-terra

# --- Route 2: through a Portkey gateway ------------------------------------
# A Portkey key present here takes precedence over the OpenAI one.
# PORTKEY_API_KEY=pk-...
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Portkey needs ONE of these so it knows which provider to route to:
# PORTKEY_PROVIDER=@openai-prod
# PORTKEY_VIRTUAL_KEY=...
# PORTKEY_CONFIG=...
# PORTKEY_MODEL=gpt-5.6-terra
